+// Fixed-point scale for S so per-range shares S * A_r / A_t keep resolution
+// when S is small. pac is only compared, so the scale is arbitrary.
+#define PAC_S_SCALE (1ull << 20)
+
+// PAC per-window tick (PACT Eq.1: S = k * misses_slow / MLP). Called every
+// pac_window_ms from the policy loop (policy_maybe_pac_tick). MLP comes from core counters, the core-side
+// analogue of PACT's TOR T1/T2: occ = per-cycle sum of pending demand reads
+// (T1), busy = cycles with >= 1 pending (T2), MLP = occ / busy. Dividing by busy
+// cycles, not the window length, is what keeps S tracking how much the slow
+// tier is used (S = k * T2 / W by Little's Law); Little's Law over the whole
+// window (MLP = lambda * W, mlp_mode 3, kept as PACT's fallback for
+// comparison) collapses S to k * dt / W. mlp_mode picks the counters (see
+// enum mlp_mode_kind); mode 0 passes occ = busy = 1. The counters are not
+// per-tier (the core does not know where a request is served), so this is the
+// VM's global MLP. misses_slow are the window's slow-tier PEBS samples.
+noinline static inline int rt_pac_tick(struct range_tree *self, u64 occ,
+				       u64 busy)
+{
+	// One window summary per second, printed whether or not stall was
+	// attributed, so a zero sample count or MLP delta is visible.
+	static unsigned long next_log;
+	struct mrange *r;
+	ulong start = 0;
+	u64 S = 0;
+	// PAC: advance the logical recency clock once per window, before this
+	// window's last_touch stamps are compared against it at demotion time.
+	self->tick += 1;
+	// mlp_mode 4: slow-tier occupancy from this window's load latency
+	// samples, period * sum of their latencies (cycles), i.e. T1_slow.
+	if (mlp_mode == MLP_MODE_SLOW_LITTLE)
+		occ = load_latency_sample_period * self->win_slow_lat_sum;
+	if (self->win_total_slow_access && occ && busy) {
+		u64 total = self->win_total_slow_access;
+		// S = k * misses * busy / occ. busy <= occ (each busy cycle adds
+		// >= 1 to occ), so the result fits whenever the first factor does.
+		S = mul_u64_u64_div_u64(pac_k * total * PAC_S_SCALE, busy, occ);
+		// Single pass: attribute stall, cool, and reset the window count.
+		mt_for_each(&self->tree, r, start, ULONG_MAX) {
+			u64 s_r = mul_u64_u64_div_u64(S, r->win_slow_access,
+						      total);
+			r->pac = mul_u64_u64_div_u64(r->pac, pac_alpha_pm, 1000) + s_r;
+			r->win_slow_access = 0;
+		}
+	} else {
+		// No slow accesses (or no MLP sample) this window: cool scores and
+		// reset in one pass.
+		mt_for_each(&self->tree, r, start, ULONG_MAX) {
+			r->pac = mul_u64_u64_div_u64(r->pac, pac_alpha_pm, 1000);
+			r->win_slow_access = 0;
+		}
+	}
+	if (time_after_eq(jiffies, next_log)) {
+		next_log = jiffies + HZ;
+		pr_info("%s: tick=%llu samples=%llu slow=%llu W=%llu occ=%llu busy=%llu mlp_x1000=%llu S=%llu\n",
+			__func__, self->tick, self->win_total_access,
+			self->win_total_slow_access,
+			self->win_total_slow_access ?
+				div64_u64(self->win_slow_lat_sum,
+					  self->win_total_slow_access) :
+				0,
+			occ, busy,
+			busy ? mul_u64_u64_div_u64(occ, 1000, busy) : 0, S);
+		pr_info("%s: cls store=%llu nophys=%llu nopage=%llu fast=%llu slow=%llu other=%llu last_other_nid=%d fmem_nid=%d smem_nid=%d\n",
+			__func__, self->win_cls[PAC_CLS_STORE],
+			self->win_cls[PAC_CLS_NOPHYS],
+			self->win_cls[PAC_CLS_NOPAGE],
+			self->win_cls[PAC_CLS_FAST], self->win_cls[PAC_CLS_SLOW],
+			self->win_cls[PAC_CLS_OTHER], self->last_other_nid,
+			(int)FMEM_NID, (int)SMEM_NID);
+	}
+	self->win_total_slow_access = 0;
+	self->win_slow_lat_sum = 0;
+	self->win_total_access = 0;
+	memset(self->win_cls, 0, sizeof(self->win_cls));
+	return 0;
+}
