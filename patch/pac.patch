+// PAC: read this window's MLP counter deltas. Returns false if the counters
+// are absent (frequency mode), leaving occ/busy zero.
+static bool policy_read_mlp(struct policy_worker *data, u64 *occ, u64 *busy)
+{
+	u64 delta[MAX_MLP_COUNTERS] = {};
+	for (int i = 0; i < MAX_MLP_COUNTERS; i++) {
+		// Workers start before target_new creates the counters.
+		struct perf_event *e = READ_ONCE(data->mlp_events[i]);
+		u64 enabled, running;
+		// mlp_mode 4 has no occupancy counter (it comes from PEBS).
+		if (!e && mlp_mode == MLP_MODE_SLOW_LITTLE && i == MLP_OCCUPANCY)
+			continue;
+		if (!e)
+			return false;
+		// Sums the inherited per-thread child events.
+		u64 val = perf_event_read_value(e, &enabled, &running);
+		if (running < enabled)
+			pr_info_ratelimited(
+				"%s: mlp counter %d multiplexed running=%llu enabled=%llu\n",
+				__func__, i, running, enabled);
+		delta[i] = val - data->mlp_prev[i];
+		data->mlp_prev[i] = val;
+	}
+	*occ = delta[MLP_OCCUPANCY];
+	*busy = delta[MLP_BUSY];
+	return true;
+}
+// PAC: close the attribution window once pac_window_ms has elapsed. Driven
+// from the policy loop, not the exchange path: Demeter exchanges only after a
+// split changes the range tree, which can stop for the rest of a run, while
+// PAC needs a steady clock (PACT: 20ms windows, MLP stable within tens of ms).
+// Samples stream continuously (throttling off by default), so the loop wakes
+// often; if the victim idles, the window stretches and the counter deltas
+// cover the same stretched span.
+static void policy_maybe_pac_tick(struct policy_worker *data)
+{
+	u64 now, occ = 0, busy = 0;
+	if (ranking_mode != RANKING_PAC)
+		return;
+	now = ktime_get_ns();
+	if (now - data->pac_last_tick_ns < pac_window_ms * NSEC_PER_MSEC)
+		return;
+	// mlp_mode 0: no counters, MLP = occ / busy = 1.
+	if (mlp_mode == MLP_MODE_NONE)
+		occ = busy = 1;
+	else
+		policy_read_mlp(data, &occ, &busy);
+	rt_pac_tick(data->rt, occ, busy);
+	data->pac_last_tick_ns = now;
+}
